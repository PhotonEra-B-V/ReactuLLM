{
  "feature": "Search box",
  "api": {
    "module": "../components/SearchBox",
    "imports": [
      "import { SearchBox } from '../components/SearchBox'"
    ],
    "signatures": [
      "export interface SearchBoxProps { onSearch: (query: string) => void; delayMs?: number; placeholder?: string }",
      "export function SearchBox(props: SearchBoxProps): JSX.Element"
    ]
  },
  "fixtures": [
    {
      "name": "makeProps",
      "body": [
        "const onSearch = jest.fn<[string], void>();",
        "return { onSearch, delayMs: 200, placeholder: 'Search…' };"
      ]
    }
  ],
  "cases": [
    {
      "scenario": "Rendering the input",
      "testName": "renders a textbox with the placeholder",
      "given": [
        "const props = makeProps();",
        "render(<SearchBox {...props} />);"
      ],
      "when": "None",
      "then": [
        "expect(screen.getByPlaceholderText('Search…')).toBeInTheDocument()"
      ],
      "fixtures": [
        "makeProps"
      ],
      "covers": [
        "rule_1",
        "M1"
      ],
      "isAsync": false,
      "edgeCase": false,
      "notes": ""
    },
    {
      "scenario": "Debounced dispatch",
      "testName": "calls onSearch once after the debounce elapses",
      "given": [
        "const props = makeProps();",
        "render(<SearchBox {...props} />);"
      ],
      "when": "await userEvent.type(screen.getByRole('textbox'), 'react')",
      "then": [
        "await waitFor(() => expect(props.onSearch).toHaveBeenCalledWith('react'))",
        "expect(props.onSearch).toHaveBeenCalledTimes(1)"
      ],
      "fixtures": [
        "makeProps"
      ],
      "covers": [
        "rule_2",
        "M2",
        "M3"
      ],
      "isAsync": true,
      "edgeCase": false,
      "notes": ""
    },
    {
      "scenario": "Empty query is ignored",
      "testName": "never dispatches an empty query",
      "given": [
        "const props = makeProps();",
        "render(<SearchBox {...props} />);"
      ],
      "when": "await userEvent.type(screen.getByRole('textbox'), '   ')",
      "then": [
        "await new Promise((r) => setTimeout(r, 300))",
        "expect(props.onSearch).not.toHaveBeenCalled()"
      ],
      "fixtures": [
        "makeProps"
      ],
      "covers": [
        "edge_1"
      ],
      "isAsync": true,
      "edgeCase": true,
      "notes": ""
    },
    {
      "scenario": "Debounce cancellation",
      "testName": "a fresh keystroke cancels the pending dispatch",
      "given": [
        "const props = makeProps();",
        "render(<SearchBox {...props} />);",
        "const box = screen.getByRole('textbox');"
      ],
      "when": "await userEvent.type(box, 'reac')",
      "then": [
        "await userEvent.type(box, 't')",
        "await waitFor(() => expect(props.onSearch).toHaveBeenCalledWith('react'))",
        "expect(props.onSearch).toHaveBeenCalledTimes(1)"
      ],
      "fixtures": [
        "makeProps"
      ],
      "covers": [
        "edge_2"
      ],
      "isAsync": true,
      "edgeCase": true,
      "notes": ""
    }
  ],
  "requiredIds": [
    "edge_1",
    "edge_2",
    "rule_1",
    "rule_2"
  ]
}
